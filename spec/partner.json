{
 "openapi": "3.1.0",
 "info": {
  "title": "Dynasty API partner API",
  "version": "1.0.0",
  "description": "Manage the dynasties your shared EA accounts are in: list and join invites, make claim links for commissioners (or, as a billed partner, turn syncing on yourself and report your payments), ask for data access and follow events. Read a dynasty's data from /v1 with the same key and a Dynasty-Id header (see /v1/docs). Calls that reach EA sign the account in to the game servers, which ends any session it has open in the game. EA calls on an invite (choices, join, finish-join, ?refresh=true) wait up to 45 s for the account (it may be syncing a dynasty) and then up to 90 s for EA: allow at least 150 s before timing out. A join that has reached EA finishes even if you hang up; check GET /dynasties before trying again. Typed SDKs for TypeScript, Python and Go: https://dynasty.prestonchoate.dev/developers"
 },
 "servers": [
  {
   "url": "/partner/v1"
  }
 ],
 "security": [
  {
   "bearer": []
  }
 ],
 "tags": [
  {
   "name": "Account",
   "description": "Your partner profile and event feed"
  },
  {
   "name": "Dynasties",
   "description": "Dynasties your EA accounts are in: claim links, access, syncing"
  },
  {
   "name": "Invites",
   "description": "Joining dynasties from their invites"
  },
  {
   "name": "Billing",
   "description": "Billed partners: turning syncing on, reporting payments, usage"
  }
 ],
 "paths": {
  "/me": {
   "get": {
    "operationId": "getMe",
    "tags": [
     "Account"
    ],
    "summary": "Your partner profile, limit and usage",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Me"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/dynasties": {
   "get": {
    "operationId": "listDynasties",
    "tags": [
     "Dynasties"
    ],
    "summary": "The dynasties each of your EA accounts is in",
    "description": "From lists at most 15 minutes old; an older list is fetched from EA, which ends any game session the account has open. While an account is syncing a dynasty, its last list is returned at once instead (`fetched_at` says how old) and fetched again when the sync ends.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DynastiesResponse"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/dynasties/refresh": {
   "post": {
    "operationId": "refreshDynasties",
    "tags": [
     "Dynasties"
    ],
    "summary": "Re-read every account's dynasty list from EA",
    "description": "Use after joining a dynasty in the game. Once per 5 minutes.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DynastiesResponse"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/dynasties/{id}/claim-links": {
   "post": {
    "operationId": "createClaimLink",
    "tags": [
     "Dynasties"
    ],
    "summary": "Make a claim link for a dynasty one of your accounts is in",
    "description": "Single use, that dynasty only, valid 7 days. Send the url to the dynasty's commissioner.",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "EA dynasty (league) id",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CreateClaimLinkBody"
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Created",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ClaimLink"
        }
       }
      }
     },
     "400": {
      "description": "bad_request",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "403": {
      "description": "terms_outdated or not_sharing",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "not_in_account: none of your accounts is in that dynasty",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "registered (send an access request instead) or at_limit",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/dynasties/{id}/access-requests": {
   "post": {
    "operationId": "createAccessRequest",
    "tags": [
     "Dynasties"
    ],
    "summary": "Ask a registered dynasty's owners for data access",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "EA dynasty (league) id",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CreateAccessRequestBody"
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Created",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AccessRequest"
        }
       }
      }
     },
     "400": {
      "description": "bad_request",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "not_registered",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "cannot_request or not_in_account",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/dynasties/{id}/sync": {
   "post": {
    "operationId": "startSync",
    "tags": [
     "Billing"
    ],
    "summary": "Turn on syncing of a dynasty one of your accounts is in, billed to you",
    "description": "Billed partners only. Registers the dynasty with no owners and gives your key access to its data. A dynasty's first start syncs for 7 days before a payment; report one with POST /dynasties/{id}/payments. Restarting a dynasty you stopped needs a payment covering now. Sends sync.started (data.billed). Calling it for a dynasty already on returns 200.",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "EA dynasty (league) id",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/StartSyncBody"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Already on",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BilledSync"
        }
       }
      }
     },
     "201": {
      "description": "Turned on",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BilledSync"
        }
       }
      }
     },
     "400": {
      "description": "bad_request",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "403": {
      "description": "not_sharing (sharing off, setup unfinished or terms outdated)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "not_in_account: none of your accounts is in that dynasty",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "not_configured (not a billed partner), registered (owners registered it: send an access request) or at_limit",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   },
   "delete": {
    "operationId": "stopSync",
    "tags": [
     "Dynasties"
    ],
    "summary": "Stop syncing a dynasty through your account",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "EA dynasty (league) id",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "204": {
      "description": "Stopped"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "not_synced",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    },
    "description": "Owners of a dynasty they registered get an email. For a dynasty billed to you, billing ends now (paid time isn't refunded); its data stays readable with your key, and POST starts it again once a payment covers it."
   }
  },
  "/dynasties/{id}/sync-interval": {
   "put": {
    "operationId": "setSyncInterval",
    "tags": [
     "Billing"
    ],
    "summary": "Change how often a dynasty billed to you syncs",
    "description": "Dynasties billed to you sync every 10 minutes unless you change it here. Each sync goes through your EA account, so syncing less often means fewer requests on it. Events such as sync results arrive when a sync runs.",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "EA dynasty (league) id",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/SyncIntervalBody"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Changed",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SyncInterval"
        }
       }
      }
     },
     "400": {
      "description": "bad_request: minutes missing or not one of the allowed values",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "not_billed: that dynasty isn't billed to you",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/dynasties/{id}/finish-join": {
   "post": {
    "operationId": "finishJoin",
    "tags": [
     "Dynasties"
    ],
    "summary": "Finish a join an earlier release left half made",
    "description": "For a dynasty one of your accounts joined through POST /invites/{id}/join before November 12, 2026. Those joins created the coach but never selected it, so the account is listed as a member while EA refuses its dynasty reads and syncs fail. This reruns the game's join on the same account and school, which selects that coach. It needs no invite. Use it only on a dynasty whose syncs fail with the account half joined. The account and school come from the recorded join; backstory defaults to the one recorded (or 4 for joins made before it was recorded).",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "EA dynasty (league) id",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/FinishJoinBody"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Finished",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/JoinResult"
        }
       }
      }
     },
     "400": {
      "description": "bad_request or bad_backstory",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "403": {
      "description": "not_sharing: finish setup, sharing turned off, or terms outdated",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "not_joined: none of your accounts joined that dynasty through Dynasty API",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "team_taken (EA shows the school taken), needs_reauth or unsupported; game_login_refused: EA's game servers won't log the account in (e.g. a PlayStation or Xbox account; sync accounts must be PC accounts that own the game); or ea_refused: EA refused with a reason of its own, in the message (e.g. \"EA refused the request: The league is full.\"). Trying again gets the same answer until that changes in the game",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "422": {
      "description": "unknown_team: the recorded school isn't in that dynasty",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "503": {
      "description": "paused; account_busy: the account was syncing a dynasty for 45 s (Retry-After: 120); ea_timeout: EA didn't answer within 90 s (Retry-After: 120); or ea_failed: EA's servers failed or dropped the connection, try again in a minute",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/invites": {
   "get": {
    "operationId": "listInvites",
    "tags": [
     "Invites"
    ],
    "summary": "Pending dynasty invites for each of your EA accounts",
    "description": "From lists at most 15 minutes old (fetched from EA when older, which ends any game session the account has open). While an account is syncing a dynasty, its last list is returned at once instead (`fetched_at` says how old) and fetched again when the sync ends. Joining is: list invites, get an invite's choices, then join with a team_id.",
    "parameters": [
     {
      "name": "refresh",
      "in": "query",
      "description": "true re-reads the lists from EA; once per 5 minutes",
      "schema": {
       "type": "boolean"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/InvitesResponse"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/invites/{id}/choices": {
   "get": {
    "operationId": "getJoinChoices",
    "tags": [
     "Invites"
    ],
    "summary": "The schools and coach backstories an invited dynasty offers",
    "description": "Opens the dynasty's coach creation on EA without making a coach.",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "EA dynasty (league) id",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/JoinChoices"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "no_invite: none of your accounts has an invite to that dynasty",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "needs_reauth; game_login_refused: EA's game servers won't log the account in (e.g. a PlayStation or Xbox account; sync accounts must be PC accounts that own the game); or ea_refused: EA refused with a reason of its own, in the message (e.g. \"EA refused the request: The league is full.\"). Trying again gets the same answer until that changes in the game",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "503": {
      "description": "paused; account_busy: the account was syncing a dynasty for 45 s (Retry-After: 120); ea_timeout: EA didn't answer within 90 s (Retry-After: 120); or ea_failed: EA's servers failed or dropped the connection, try again in a minute",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/invites/{id}/join": {
   "post": {
    "operationId": "joinInvite",
    "tags": [
     "Invites"
    ],
    "summary": "Accept an invite by taking a school in the dynasty",
    "description": "Makes your account's coach at the school, the same as accepting the invite in the game. This writes to the dynasty and takes that school's spot. Afterwards the dynasty is in GET /dynasties, ready for a claim link. The inviter and cross-play setting come from EA's invite, not the request.",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "EA dynasty (league) id",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/JoinInviteBody"
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Joined",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/JoinResult"
        }
       }
      }
     },
     "400": {
      "description": "bad_request or bad_backstory",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "403": {
      "description": "not_sharing: finish setup, sharing turned off, or terms outdated",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "no_invite",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "team_taken, needs_reauth or unsupported; game_login_refused: EA's game servers won't log the account in (e.g. a PlayStation or Xbox account; sync accounts must be PC accounts that own the game); or ea_refused: EA refused with a reason of its own, in the message (e.g. \"EA refused the request: The league is full.\"). Trying again gets the same answer until that changes in the game",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "422": {
      "description": "unknown_team: not on offer in that dynasty",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "503": {
      "description": "paused; account_busy: the account was syncing a dynasty for 45 s (Retry-After: 120); ea_timeout: EA didn't answer within 90 s (Retry-After: 120); or ea_failed: EA's servers failed or dropped the connection, try again in a minute",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/events": {
   "get": {
    "operationId": "listEvents",
    "tags": [
     "Account"
    ],
    "summary": "Your event feed, oldest first",
    "description": "Poll with the last next_after. Types: claim.completed (data.state), access.granted, access.revoked, access.denied, sync.started (data.billed; data.moved, data.paid_until and data.grace_until when we moved an owner-paid dynasty to your billing: start charging at paid_until), sync.stopped (data.reason), account.needs_reauth, billing.payment_required (data.syncing, data.paid_until, data.grace_until: sent when a billed dynasty's paid period ends, with syncing true, and again when its grace ends and syncing pauses, with syncing false).",
    "parameters": [
     {
      "name": "after",
      "in": "query",
      "description": "An event id; events after it",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "schema": {
       "type": "integer",
       "default": 100,
       "maximum": 500
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EventsResponse"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/dynasties/{id}/payments": {
   "post": {
    "operationId": "reportPayment",
    "tags": [
     "Billing"
    ],
    "summary": "Report a payment you transferred for a dynasty",
    "description": "On each payment, transfer at least your price for the period (price_cents × days ÷ 31, rounded down, a started day counting whole: a month of any length needs at most price_cents) to our Connect account, then report the transfer's destination_payment (py_…, not the tr_… transfer id) with the period it pays for. It's checked with Stripe: succeeded, from a transfer, USD, not refunded, enough for the period. A period is at most 400 days and starts no later than tomorrow. One payment covers one dynasty and period. The dynasty syncs until 7 days after the latest period_end it's paid to; a refund or reversed transfer stops a payment covering it. Repeating a report returns 200.",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "EA dynasty (league) id",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ReportPaymentBody"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Already recorded",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Payment"
        }
       }
      }
     },
     "201": {
      "description": "Recorded",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Payment"
        }
       }
      }
     },
     "400": {
      "description": "bad_request",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "not_billed: that dynasty was never billed to you",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "payment_rejected (the message says which check failed), payment_already_used or not_configured",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "503": {
      "description": "stripe_unavailable: send the same report again",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/usage": {
   "get": {
    "operationId": "getUsage",
    "tags": [
     "Billing"
    ],
    "summary": "Dynasties billed to you in a month, for matching your transfers",
    "description": "Each dynasty billed to you at any time in the UTC month, with its billed days in the month (a started day counting whole) and their share of your monthly price (a whole month is the price).",
    "parameters": [
     {
      "name": "month",
      "in": "query",
      "description": "YYYY-MM (UTC); this month by default",
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Usage"
        }
       }
      }
     },
     "400": {
      "description": "bad_request",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "default": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer",
    "description": "Authorization: Bearer cfbp_…"
   }
  },
  "responses": {
   "Unauthorized": {
    "description": "Missing or invalid partner key",
